# Example environment variables for AI Friend
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# APPLICATION
# ============================================
APP_NAME=ai-friend
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://ai_friend:password@localhost:5432/ai_friend
DATABASE_ECHO=false

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LLM PROVIDER (uncomment one)
# ============================================
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key

# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key

# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key

# ============================================
# SPEECH RECOGNITION
# ============================================
# ASR_MODEL=whisper
# WHISPER_MODEL_SIZE=base

# ============================================
# TEXT-TO-SPEECH (optional)
# ============================================
# TTS_PROVIDER=none
# TTS_API_KEY=your-tts-api-key

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# ML MODELS
# ============================================
# EMOTION_MODEL_PATH=ml/voice_emotion/checkpoints/best_model.pt
# EMOTION_MODEL_VERSION=0.1.0
